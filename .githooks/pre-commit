#!/bin/sh
# Local token guard. Enable with `just hooks`.
# Fails the commit if the staged diff contains the SEVDESK_API_KEY from .env,
# or if any file in the index has a lastLogin+Ip key whose value is not a
# placeholder (null, "SDRS-SAMPLE", "REDACTED", ""), a sign of an unredacted
# account object in a recorded response. Neither the token nor the offending
# value is ever printed.

if [ -f .env ]; then
    token=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}SEVDESK_API_KEY=//p' .env | head -n 1)
    token=${token%\"}; token=${token#\"}; token=${token%\'}; token=${token#\'}
    if [ -n "$token" ] && git diff --cached | grep -qF -e "$token"; then
        echo "pre-commit: the staged diff contains SEVDESK_API_KEY from .env. Commit aborted." >&2
        exit 1
    fi
fi

# The pattern is split so that this file does not match itself.
# -o yields only "key: value" (value up to the next , or }), so several keys on
# one line are judged separately. Anything not an allowed placeholder is
# reported as file:line only.
bad=$(git grep --cached -n -o -E -e '"lastLogin''Ip"[[:space:]]*:[[:space:]]*[^,}]*' \
    | grep -v -E ':[[:space:]]*(null|"SDRS-SAMPLE"|"REDACTED"|"")[[:space:]]*$' \
    | sed 's/^\([^:]*:[0-9]*\):.*/\1/')
if [ -n "$bad" ]; then
    echo 'pre-commit: a staged file has a "lastLogin''Ip" key with a non-placeholder value (unredacted account/user object). Commit aborted. Locations:' >&2
    echo "$bad" >&2
    exit 1
fi
